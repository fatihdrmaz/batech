# İletişim formu: Kendi SMTP sunucunuzla e-posta gönderir (Gmail, Yandex, hosting SMTP vb.)
# Gmail: Normal şifre çalışmaz, "Uygulama şifresi" (2 adımlı doğrulama açık) kullanın.
# Vercel: Bu değişkenleri Settings → Environment Variables'a ekleyin, sonra Redeploy yapın.
CONTACT_EMAIL=info@ornek.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
# Sadece mail sunucusu yanlış sertifika sunuyorsa (Hostname does not match certificate): SMTP_INSECURE_TLS=true
# SMTP_INSECURE_TLS=true

# Site URL (sitemap, robots, OG için)
NEXT_PUBLIC_SITE_URL=https://batech.com.tr

# Google Maps: Harita → Paylaş → Haritayı yerleştir → src kopyalayın (opsiyonel)
# NEXT_PUBLIC_GOOGLE_MAPS_EMBED_URL=

# Katalog PDF: public/katalog.pdf veya harici link (opsiyonel)
NEXT_PUBLIC_KATALOG_URL=

# Google Analytics 4: Admin → Data Streams → Web → Measurement ID (G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
